{
  "name": "cqu-moe-design",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm --filter @cqu-moe/theme build && pnpm --filter @cqu-moe/ui build && pnpm --filter @cqu-moe/preview build",
    "dev": "pnpm --filter @cqu-moe/preview dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/run-browser-tests.mjs --project=chromium-desktop --project=chromium-mobile",
    "check": "pnpm build && pnpm typecheck && pnpm test && node --test tests/*.test.mjs && node scripts/check-design.mjs",
    "verify:consumer": "node scripts/verify-consumer.mjs",
    "verify:auth-consumer": "node scripts/verify-auth-consumer.mjs",
    "verify:auth-consumer:harness": "node scripts/verify-auth-consumer-harness.mjs",
    "format": "prettier --write packages apps templates scripts tests *.json *.ts",
    "create:app": "pnpm build && node scripts/create-app.mjs",
    "deploy": "pnpm build && pnpm dlx wrangler@4.94.0 deploy",
    "brand:build": "node assets/brand/path-family/source/build.cjs && python3 scripts/package-brand.py",
    "brand:verify": "node assets/brand/path-family/source/verify.cjs",
    "brand:prepare": "node scripts/brand.mjs prepare",
    "brand:sync": "node scripts/brand.mjs sync",
    "brand:check": "node scripts/brand.mjs check",
    "test:e2e:release": "node scripts/run-browser-tests.mjs",
    "test:e2e:harness": "node scripts/verify-browser-harness.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
